    "supertest": "^7.2.2"
  },

  "jest": {
    "coverageDirectory": "./coverage",
    "coverageReporters": ["json", "lcov", "text", "clover"],
    "testEnvironment": "node",
    "testRegex": "(/tests/.*|(\\.|/)(test|spec))\\.(jsx?|js?|tsx?|ts?)$",
    "moduleFileExtensions": ["js", "jsx", "json", "node"],
    "collectCoverageFrom": ["**/*.js", "!**/node_modules/**", "!**/coverage/**", "!**/dist/**", "!**/build/**", "!**/docs/**", "!**/examples/**", "!**/tests/**", "!**/test/**", "!**/test-results/**", "!**/test-reports/**", "!**/test-results/**", "!**/test-reports/**", "!**/test-results/**", "!**/test-reports/**"]
  }
